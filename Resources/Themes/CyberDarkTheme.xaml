<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="BackgroundPrimaryColor">#05050A</Color>
    <SolidColorBrush x:Key="BackgroundPrimaryBrush" Color="{StaticResource BackgroundPrimaryColor}"/>

    <Color x:Key="BackgroundSecondaryColor">#0A0A14</Color>
    <SolidColorBrush x:Key="BackgroundSecondaryBrush" Color="{StaticResource BackgroundSecondaryColor}"/>

    <Color x:Key="SurfaceCardColor">#12121F</Color>
    <SolidColorBrush x:Key="SurfaceCardBrush" Color="{StaticResource SurfaceCardColor}"/>

    <Color x:Key="SurfaceCardHoverColor">#1A1A2E</Color>
    <SolidColorBrush x:Key="SurfaceCardHoverBrush" Color="{StaticResource SurfaceCardHoverColor}"/>

    <!-- ===================== BORDERS ===================== -->
    <Color x:Key="BorderDefaultColor">#2A2A45</Color>
    <SolidColorBrush x:Key="BorderDefaultBrush" Color="{StaticResource BorderDefaultColor}"/>

    <Color x:Key="BorderStrongColor">#3D3D6B</Color>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}"/>

    <!-- ===================== TEXT ===================== -->
    <Color x:Key="TextPrimaryColor">#E4E4F7</Color>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>

    <Color x:Key="TextSecondaryColor">#9494C8</Color>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>

    <Color x:Key="TextMutedColor">#5C5C8A</Color>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>

    <!-- ===================== ACCENT ===================== -->
    <Color x:Key="AccentStartColor">#00F0FF</Color>
    <Color x:Key="AccentEndColor">#FF00E5</Color>

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource AccentStartColor}" Offset="0"/>
        <GradientStop Color="{StaticResource AccentEndColor}" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="AccentSolidBrush" Color="{StaticResource AccentEndColor}"/>

    <!-- ===================== STATUS COLORS ===================== -->
    <Color x:Key="SuccessColor">#00FFA3</Color>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>

    <Color x:Key="WarningColor">#FFE600</Color>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>

    <Color x:Key="ErrorColor">#FF2E63</Color>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>

    <Color x:Key="PartialColor">#B24BF3</Color>
    <SolidColorBrush x:Key="PartialBrush" Color="{StaticResource PartialColor}"/>

    <!-- ===================== EXPORT ACCENT (PDF actions) ===================== -->
    <Color x:Key="ExportAccentColor">#00E5FF</Color>
    <SolidColorBrush x:Key="ExportAccentBrush" Color="{StaticResource ExportAccentColor}"/>

</ResourceDictionary> 
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:vm="clr-namespace:Finvora.ViewModels"
                     xmlns:views="clr-namespace:Finvora.Views">

	<DataTemplate DataType="{x:Type vm:DashboardViewModel}">
		<views:DashboardView/>
	</DataTemplate>

	<DataTemplate DataType="{x:Type vm:ComingSoonViewModel}">
		<views:ComingSoonView/>
	</DataTemplate>

	<DataTemplate DataType="{x:Type vm:CustomersViewModel}">
		<views:CustomersView/>
	</DataTemplate>

</ResourceDictionary>

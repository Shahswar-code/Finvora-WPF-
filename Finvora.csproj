<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<ApplicationIcon>Assets\finvora.ico</ApplicationIcon>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.0-rc5.4" />
	</ItemGroup>

	<!--
      Every image dropped into Assets is physically copied to the build output
      folder, so it's easy to verify on disk that the logo actually made it in.
  -->
	<ItemGroup>
		<Content Include="Assets\**\*.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<!--
      Safety net: if a stray App.xaml ends up anywhere else under this project
      (e.g. a leftover nested folder from a copy/paste mistake), it will NOT be
      treated as a second application entry point. Only the root App.xaml counts.
  -->
	<ItemGroup>
		<ApplicationDefinition Remove="**\App.xaml" />
		<ApplicationDefinition Include="App.xaml" />
	</ItemGroup>

</Project>  
<Window x:Class="Finvora.Views.PinDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Finvora.ViewModels"
        xmlns:conv="clr-namespace:Finvora.Converters"
        Title="Security PIN"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        AllowsTransparency="True"
        Background="Transparent"
        Width="420" SizeToContent="Height"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="PinBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="{DynamicResource BackgroundSecondaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="MaxLength" Value="6"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentSolidBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource SurfaceCardBrush}" CornerRadius="12"
            BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="24,20,24,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding HeaderTitle}" Style="{StaticResource TextHeading}"/>
                    <TextBlock Text="{Binding HeaderSubtitle}" Style="{StaticResource TextCaption}"
                               Margin="0,2,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                        Width="28" Height="28" Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand"
                        VerticalAlignment="Top" Command="{Binding CancelCommand}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Body -->
            <StackPanel Grid.Row="1" Margin="24,14,24,0">

                <!-- Current PIN (Change mode only) -->
                <StackPanel Visibility="{Binding ShowCurrentPin, Converter={StaticResource BoolToVis}}" Margin="0,0,0,14">
                    <TextBlock Text="Current PIN" Style="{StaticResource FieldLabel}"/>
                    <PasswordBox x:Name="CurrentPinBox" Style="{StaticResource PinBox}"
                                 PasswordChanged="CurrentPinBox_PasswordChanged"/>
                </StackPanel>

                <!-- New + Confirm PIN (SetupNew and Change modes) -->
                <StackPanel Visibility="{Binding ShowNewPinFields, Converter={StaticResource BoolToVis}}">
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="New PIN (4-6 digits)" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox x:Name="NewPinBox" Style="{StaticResource PinBox}"
                                     PasswordChanged="NewPinBox_PasswordChanged"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Confirm New PIN" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox x:Name="ConfirmPinBox" Style="{StaticResource PinBox}"
                                     PasswordChanged="ConfirmPinBox_PasswordChanged"/>
                    </StackPanel>
                </StackPanel>

                <!-- Single PIN entry (Verify mode) -->
                <StackPanel Visibility="{Binding ShowVerifyField, Converter={StaticResource BoolToVis}}" Margin="0,0,0,14">
                    <TextBlock Text="Enter PIN" Style="{StaticResource FieldLabel}"/>
                    <PasswordBox x:Name="VerifyPinBox" Style="{StaticResource PinBox}"
                                 PasswordChanged="VerifyPinBox_PasswordChanged"/>
                </StackPanel>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorBrush}"
                           TextWrapping="Wrap" Margin="0,4,0,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
            </StackPanel>

            <!-- Footer -->
            <Grid Grid.Row="2" Margin="24,20,24,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelCommand}"
                        Padding="16,9" Background="Transparent"
                        Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="1"
                        BorderBrush="{DynamicResource BorderDefaultBrush}" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Grid.Column="3" Content="Confirm" Command="{Binding ConfirmCommand}"
                        Padding="16,9" FontWeight="SemiBold"
                        Background="{DynamicResource AccentSolidBrush}" Foreground="White"
                        BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

        </Grid>
    </Border>
</Window> 
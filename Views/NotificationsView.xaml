<UserControl x:Class="Finvora.Views.NotificationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Finvora.Models">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="RefreshButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Hidden">
        <StackPanel Margin="0,0,0,20">

            <!-- Header -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Notifications" FontSize="24" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="New customers and overdue payments show up here"
                               Style="{StaticResource TextCaption}" Margin="0,4,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}"
                        Style="{StaticResource RefreshButtonStyle}"
                        Background="{DynamicResource AccentSolidBrush}"/>
            </Grid>

            <!-- Empty state -->
            <StackPanel HorizontalAlignment="Center" Margin="0,60,0,0"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="&#xE7E7;" FontFamily="Segoe MDL2 Assets" FontSize="32"
                           Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="You're all caught up" Style="{StaticResource TextSubheading}"
                           HorizontalAlignment="Center" Margin="0,10,0,4"/>
                <TextBlock Text="New customers and overdue alerts will show up here."
                           Style="{StaticResource TextCaption}" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Notification list -->
            <ItemsControl ItemsSource="{Binding Notifications}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource SurfaceCardBrush}" CornerRadius="10"
                                Padding="16" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19"
                                        VerticalAlignment="Top" Margin="0,0,14,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource AccentSolidBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Type}" Value="{x:Static models:NotificationType.Overdue}">
                                                    <Setter Property="Background" Value="{DynamicResource ErrorBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="{x:Static models:NotificationType.CustomerAdded}">
                                                    <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource TextSubheading}"/>
                                    <TextBlock Text="{Binding Message}" Style="{StaticResource TextBody}"
                                               TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:dd MMM yyyy, hh:mm tt}'}"
                                               Style="{StaticResource TextCaption}" Margin="0,6,0,0"/>
                                </StackPanel>

                                <Ellipse Grid.Column="2" Width="8" Height="8" Fill="{DynamicResource AccentSolidBrush}"
                                         VerticalAlignment="Top" Margin="10,4,0,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRead}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>  
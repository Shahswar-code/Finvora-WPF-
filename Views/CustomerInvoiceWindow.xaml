<Window x:Class="Finvora.Views.CustomerInvoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Finvora.ViewModels"
        xmlns:conv="clr-namespace:Finvora.Converters"
        Title="Customer Invoice"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        AllowsTransparency="True"
        Background="Transparent"
        Width="560" SizeToContent="Height"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <conv:PercentToWidthConverter x:Key="PercentToWidthConverter"/>
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="RowLabel" TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RowValue" TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>

        <Style x:Key="InfoRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource SurfaceCardBrush}" CornerRadius="12"
            BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="28,22,28,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Invoice" Style="{StaticResource TextHeading}"/>
                    <TextBlock Style="{StaticResource TextCaption}" Margin="0,2,0,0">
                        <Run Text="{Binding InvoiceNumber, Mode=OneWay}"/>
                        <Run Text=" · Generated "/>
                        <Run Text="{Binding GeneratedOn, Mode=OneWay, StringFormat='dd MMM yyyy, hh:mm tt'}"/>
                    </TextBlock>
                </StackPanel>

                <!-- Download PDF -->
                <Button Grid.Column="1" Command="{Binding DownloadPdfCommand}"
                        Padding="12,7" Margin="0,0,10,0" Cursor="Hand"
                        Background="{DynamicResource BackgroundSecondaryBrush}"
                        BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Download PDF" Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="2" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                        Width="28" Height="28" Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand"
                        Command="{Binding CloseCommand}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Body -->
            <ScrollViewer Grid.Row="1" MaxHeight="600" VerticalScrollBarVisibility="Auto" Margin="28,14,28,0">
                <StackPanel>

                    <!-- Overdue flag -->
                    <Border Background="{DynamicResource ErrorBrush}" CornerRadius="6" Padding="10,7" Margin="0,0,0,14"
                            Visibility="{Binding IsOverdue, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="⚠ This plan is overdue" Foreground="White" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" FontSize="{StaticResource FontSizeBody}"/>
                    </Border>

                    <!-- Bill To -->
                    <TextBlock Text="Bill To" Style="{StaticResource TextSubheading}" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding FullName}" FontWeight="Bold" FontSize="20"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding Phone}" Style="{StaticResource TextCaption}"/>
                    <TextBlock Text="{Binding Email}" Style="{StaticResource TextCaption}"
                               Visibility="{Binding Email, Converter={StaticResource StringToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding Cnic}" Style="{StaticResource TextCaption}"
                               Visibility="{Binding Cnic, Converter={StaticResource StringToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding Address}" Style="{StaticResource TextCaption}" TextWrapping="Wrap"
                               Visibility="{Binding Address, Converter={StaticResource StringToVisibilityConverter}}"/>

                    <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0,1,0,0" Margin="0,18,0,16"/>

                    <!-- Plan details -->
                    <TextBlock Text="Plan Details" Style="{StaticResource TextSubheading}" Margin="0,0,0,10"/>

                    <Grid Style="{StaticResource InfoRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Item / Plan" Style="{StaticResource RowLabel}"/>
                        <TextBlock Grid.Column="1" Text="{Binding ItemName}" Style="{StaticResource RowValue}"/>
                    </Grid>
                    <Grid Style="{StaticResource InfoRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Frequency" Style="{StaticResource RowLabel}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Frequency}" Style="{StaticResource RowValue}"/>
                    </Grid>
                    <Grid Style="{StaticResource InfoRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Started On" Style="{StaticResource RowLabel}"/>
                        <TextBlock Grid.Column="1" Text="{Binding DateAdded, StringFormat='dd MMM yyyy'}" Style="{StaticResource RowValue}"/>
                    </Grid>
                    <Grid Style="{StaticResource InfoRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Next / Last Due Date" Style="{StaticResource RowLabel}"/>
                        <TextBlock Grid.Column="1" Text="{Binding DueDate, StringFormat='dd MMM yyyy'}" Style="{StaticResource RowValue}"/>
                    </Grid>

                    <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0,1,0,0" Margin="0,18,0,16"/>

                    <!-- Payment summary -->
                    <TextBlock Text="Payment Summary" Style="{StaticResource TextSubheading}" Margin="0,0,0,10"/>

                    <Grid Style="{StaticResource InfoRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Total Price" Style="{StaticResource RowLabel}"/>
                        <TextBlock Grid.Column="1" Text="{Binding TotalPrice, StringFormat='Rs {0:N0}'}" Style="{StaticResource RowValue}"/>
                    </Grid>
                    <Grid Style="{StaticResource InfoRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Advance Paid" Style="{StaticResource RowLabel}"/>
                        <TextBlock Grid.Column="1" Text="{Binding AdvancePaid, StringFormat='Rs {0:N0}'}" Style="{StaticResource RowValue}"/>
                    </Grid>
                    <Grid Style="{StaticResource InfoRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Total Amount Paid" Style="{StaticResource RowLabel}"/>
                        <TextBlock Grid.Column="1" Text="{Binding AmountPaid, StringFormat='Rs {0:N0}'}" Style="{StaticResource RowValue}"/>
                    </Grid>

                    <!-- Progress bar -->
                    <Border Height="8" Background="{DynamicResource BackgroundSecondaryBrush}" CornerRadius="4" Margin="0,10,0,4">
                        <Border HorizontalAlignment="Left" Height="8" CornerRadius="4"
                                Background="{DynamicResource AccentSolidBrush}"
                                Width="{Binding PaymentProgressPercent, Converter={StaticResource PercentToWidthConverter}, ConverterParameter=496}"/>
                    </Border>
                    <TextBlock Text="{Binding PaymentProgressPercent, StringFormat='{}{0:N0}% paid'}"
                                Style="{StaticResource TextCaption}" Margin="0,0,0,14"/>

                    <!-- Remaining balance -->
                    <Border Background="{DynamicResource BackgroundSecondaryBrush}" CornerRadius="8" Padding="14,10" Margin="0,0,0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Remaining Balance" Style="{StaticResource TextSubheading}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding RemainingBalance, StringFormat='Rs {0:N0}'}"
                                       Style="{StaticResource TextSubheading}" Foreground="{DynamicResource WarningBrush}"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="{Binding ExportMessage}" Style="{StaticResource TextCaption}"
                               Foreground="{DynamicResource SuccessBrush}" Margin="0,10,0,0"
                               Visibility="{Binding ExportMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Grid Grid.Row="2" Margin="28,20,28,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" Content="Close" Command="{Binding CloseCommand}"
                        Padding="18,9" Background="Transparent"
                        Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="1"
                        BorderBrush="{DynamicResource BorderDefaultBrush}" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

        </Grid>
    </Border>
</Window> 
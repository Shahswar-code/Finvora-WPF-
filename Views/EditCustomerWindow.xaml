<Window x:Class="Finvora.Views.EditCustomerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Finvora.ViewModels"
        xmlns:conv="clr-namespace:Finvora.Converters"
        Title="Update Payment"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        AllowsTransparency="True"
        Background="Transparent"
        Width="480" SizeToContent="Height"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="FieldTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource BackgroundSecondaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentSolidBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Flat action button used inside both flash-cards -->
        <Style x:Key="CardActionButton" TargetType="Button">
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource SurfaceCardBrush}" CornerRadius="12"
            BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="24,20,24,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Update Payment" Style="{StaticResource TextHeading}"/>
                    <TextBlock Style="{StaticResource TextCaption}" Margin="0,2,0,0">
                        <Run Text="{Binding FullName, Mode=OneWay}"/>
                        <Run Text=" — "/>
                        <Run Text="{Binding ItemName, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
                <Button Grid.Column="1" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                        Width="28" Height="28" Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand"
                        VerticalAlignment="Top"
                        Command="{Binding CancelCommand}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Body -->
            <StackPanel Grid.Row="1" Margin="24,10,24,0">

                <!-- Summary strip -->
                <Border Background="{DynamicResource BackgroundSecondaryBrush}" CornerRadius="8" Padding="14,12" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Total Price" Style="{StaticResource TextCaption}"/>
                            <TextBlock Grid.Column="1" Text="{Binding TotalPrice, StringFormat='Rs {0:N0}'}" Style="{StaticResource TextCaption}"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Amount Paid" Style="{StaticResource TextCaption}"/>
                            <TextBlock Grid.Column="1" Text="{Binding AmountPaid, StringFormat='Rs {0:N0}'}" Style="{StaticResource TextCaption}"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Remaining Balance" Style="{StaticResource TextSubheading}"/>
                            <TextBlock Grid.Column="1" Text="{Binding RemainingBalance, StringFormat='Rs {0:N0}'}"
                                       Style="{StaticResource TextSubheading}" Foreground="{DynamicResource WarningBrush}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Payment cards (hidden once fully paid) -->
                <StackPanel Visibility="{Binding NeedsPayment, Converter={StaticResource BoolToVis}}">

                    <!-- Green: Mark Fully Paid -->
                    <Border Background="{DynamicResource SuccessBrush}" CornerRadius="8" Padding="16,14" Margin="0,0,0,12" Opacity="0.15"/>
                    <Border BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="1" CornerRadius="8"
                            Padding="16,14" Margin="0,-40,0,12">
                        <StackPanel>
                            <TextBlock Text="Mark as Fully Paid" Style="{StaticResource TextSubheading}" Foreground="{DynamicResource SuccessBrush}"/>
                            <TextBlock Text="Settles the remaining balance in one tap." Style="{StaticResource TextCaption}" Margin="0,4,0,12" TextWrapping="Wrap"/>
                            <Button Content="Mark Fully Paid" Command="{Binding MarkFullyPaidCommand}"
                                    Background="{DynamicResource SuccessBrush}" Style="{StaticResource CardActionButton}"/>
                        </StackPanel>
                    </Border>

                    <!-- Yellow: Record Partial Payment -->
                    <Border Background="{DynamicResource WarningBrush}" CornerRadius="8" Padding="16,14" Margin="0,0,0,4" Opacity="0.15"/>
                    <Border BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" CornerRadius="8"
                            Padding="16,14" Margin="0,-42,0,4">
                        <StackPanel>
                            <TextBlock Text="Record a Partial Payment" Style="{StaticResource TextSubheading}" Foreground="{DynamicResource WarningBrush}"/>
                            <TextBlock Text="Adds this amount to Amount Paid." Style="{StaticResource TextCaption}" Margin="0,4,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding PartialAmountText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FieldTextBox}"/>
                                <Button Grid.Column="2" Content="Record Payment" Command="{Binding RecordPartialPaymentCommand}"
                                        Background="{DynamicResource WarningBrush}" Style="{StaticResource CardActionButton}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- Already fully paid -->
                <Border Background="{DynamicResource BackgroundSecondaryBrush}" CornerRadius="8" Padding="16,14" Margin="0,0,0,4"
                        Visibility="{Binding IsFullyPaid, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="This plan is fully paid." Style="{StaticResource TextSubheading}"
                               Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center"/>
                </Border>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorBrush}"
                           TextWrapping="Wrap" Margin="0,14,0,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

            </StackPanel>

            <!-- Footer -->
            <Grid Grid.Row="2" Margin="24,20,24,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" Content="Close" Command="{Binding CancelCommand}"
                        Padding="18,9" Background="Transparent"
                        Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="1"
                        BorderBrush="{DynamicResource BorderDefaultBrush}" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

        </Grid>
    </Border>
</Window>  
<UserControl x:Class="Finvora.Views.InstallmentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Finvora.Views"
             xmlns:converters="clr-namespace:Finvora.Converters"
             xmlns:models="clr-namespace:Finvora.Models">

    <UserControl.Resources>
        <converters:StringEqualsConverter x:Key="StringEqualsConverter"/>
        <converters:PercentToWidthMultiConverter x:Key="PercentToWidthMultiConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="FilterPillStyle" TargetType="RadioButton">
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSolidBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="0,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Hidden">
        <StackPanel Margin="0,0,0,20">

            <!-- Header -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Installments" FontSize="24" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Every installment plan across all customers"
                               Style="{StaticResource TextCaption}" Margin="0,4,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" Content="New Installment" Command="{Binding NewInstallmentCommand}"
                        Background="{DynamicResource AccentSolidBrush}"
                        Style="{StaticResource HeaderButtonStyle}" VerticalAlignment="Top"/>
            </Grid>

            <!-- Stat cards -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <views:StatCardView Grid.Column="0" Title="TOTAL PLANS" Value="{Binding TotalInstallments}"
                                     Badge="&#xE8FD;" AccentBrush="{DynamicResource AccentSolidBrush}"/>
                <views:StatCardView Grid.Column="2" Title="ACTIVE" Value="{Binding ActiveCount}"
                                     Badge="&#xE73A;" AccentBrush="{DynamicResource PartialBrush}"/>
                <views:StatCardView Grid.Column="4" Title="DUE TODAY" Value="{Binding DueTodayCount}"
                                     Badge="&#xE787;" AccentBrush="{DynamicResource WarningBrush}"/>
                <views:StatCardView Grid.Column="6" Title="OVERDUE" Value="{Binding OverdueCount}"
                                     Badge="&#xE7BA;" AccentBrush="{DynamicResource ErrorBrush}"/>
                <views:StatCardView Grid.Column="8" Title="OUTSTANDING" Value="{Binding TotalOutstanding}"
                                     Badge="&#xE8C7;" AccentBrush="{DynamicResource SuccessBrush}"/>
            </Grid>

            <!-- Search + filters -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="12,9" Background="{DynamicResource SurfaceCardBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="1"
                             BorderBrush="{DynamicResource BorderDefaultBrush}"/>
                    <TextBlock Text="Search by customer, phone, item or ID..." IsHitTestVisible="False"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="12,0,0,0"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton Content="All" GroupName="InstallmentStatusFilter" Style="{StaticResource FilterPillStyle}"
                                 Command="{Binding SetFilterCommand}" CommandParameter="All"
                                 IsChecked="{Binding SelectedFilter, Converter={StaticResource StringEqualsConverter}, ConverterParameter=All, Mode=OneWay}"/>
                    <RadioButton Content="Active" GroupName="InstallmentStatusFilter" Style="{StaticResource FilterPillStyle}"
                                 Command="{Binding SetFilterCommand}" CommandParameter="Active"
                                 IsChecked="{Binding SelectedFilter, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Active, Mode=OneWay}"/>
                    <RadioButton Content="Due Today" GroupName="InstallmentStatusFilter" Style="{StaticResource FilterPillStyle}"
                                 Command="{Binding SetFilterCommand}" CommandParameter="DueToday"
                                 IsChecked="{Binding SelectedFilter, Converter={StaticResource StringEqualsConverter}, ConverterParameter=DueToday, Mode=OneWay}"/>
                    <RadioButton Content="Overdue" GroupName="InstallmentStatusFilter" Style="{StaticResource FilterPillStyle}"
                                 Command="{Binding SetFilterCommand}" CommandParameter="Overdue"
                                 IsChecked="{Binding SelectedFilter, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Overdue, Mode=OneWay}"/>
                    <RadioButton Content="Completed" GroupName="InstallmentStatusFilter" Style="{StaticResource FilterPillStyle}"
                                 Command="{Binding SetFilterCommand}" CommandParameter="Completed"
                                 IsChecked="{Binding SelectedFilter, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Completed, Mode=OneWay}"/>
                </StackPanel>
            </Grid>

            <!-- Empty state -->
            <StackPanel HorizontalAlignment="Center" Margin="0,60,0,0"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="32"
                           Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="No installment accounts yet" Style="{StaticResource TextSubheading}"
                           HorizontalAlignment="Center" Margin="0,10,0,4"/>
                <TextBlock Text="Create your first installment plan to start tracking payments."
                           Style="{StaticResource TextCaption}" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Installment cards -->
            <ItemsControl ItemsSource="{Binding FilteredInstallments}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="460" Background="{DynamicResource SurfaceCardBrush}"
                                CornerRadius="10" Padding="18" Margin="0,0,16,16">
                            <StackPanel>

                                <!-- Top row: id/customer, status badge -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding InstallmentNumber}" Style="{StaticResource TextCaption}"/>
                                        <TextBlock Text="{Binding CustomerName}" Style="{StaticResource TextSubheading}" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding ItemName}" Style="{StaticResource TextCaption}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <Border Grid.Column="1" CornerRadius="5" Padding="9,4" VerticalAlignment="Top">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding FilterCategory}" Value="Overdue">
                                                        <Setter Property="Background" Value="{DynamicResource ErrorBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding FilterCategory}" Value="DueToday">
                                                        <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding FilterCategory}" Value="Completed">
                                                        <Setter Property="Background" Value="{DynamicResource TextMutedBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Status}" FontSize="11"
                                                   FontWeight="SemiBold" Foreground="White"/>
                                    </Border>
                                </Grid>

                                <!-- Financial summary row -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Total" Style="{StaticResource TextCaption}"/>
                                        <TextBlock Text="{Binding TotalPrice, StringFormat='Rs {0:N0}'}"
                                                   Style="{StaticResource TextBody}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Paid" Style="{StaticResource TextCaption}"/>
                                        <TextBlock Text="{Binding PaidAmount, StringFormat='Rs {0:N0}'}"
                                                   Style="{StaticResource TextBody}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SuccessBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Outstanding" Style="{StaticResource TextCaption}"/>
                                        <TextBlock Text="{Binding OutstandingAmount, StringFormat='Rs {0:N0}'}"
                                                   Style="{StaticResource TextBody}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource WarningBrush}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Progress -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Payment Progress" Style="{StaticResource TextCaption}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ProgressPercent, StringFormat='{}{0:0}%'}"
                                               Style="{StaticResource TextCaption}"/>
                                </Grid>

                                <Border x:Name="ProgressTrack" Height="6" Background="{DynamicResource SurfaceCardHoverBrush}"
                                        CornerRadius="3" ClipToBounds="True" Margin="0,0,0,10">
                                    <Border HorizontalAlignment="Left" CornerRadius="3"
                                            Background="{DynamicResource SuccessBrush}">
                                        <Border.Width>
                                            <MultiBinding Converter="{StaticResource PercentToWidthMultiConverter}">
                                                <MultiBinding.Bindings>
                                                    <Binding Path="ProgressPercent"/>
                                                    <Binding ElementName="ProgressTrack" Path="ActualWidth"/>
                                                </MultiBinding.Bindings>
                                            </MultiBinding>
                                        </Border.Width>
                                    </Border>
                                </Border>

                                <TextBlock Style="{StaticResource TextCaption}" Margin="0,0,0,14">
                                    <Run Text="Rs "/><Run Text="{Binding InstallmentAmount, StringFormat={}{0:N0}, Mode=OneWay}"/><Run Text="/"/><Run Text="{Binding PlanShortLabel, Mode=OneWay}"/>
                                    <Run Text="   Next due: "/><Run Text="{Binding NextDueDate, StringFormat={}{0:dd MMM yyyy}, Mode=OneWay}"/>
                                </TextBlock>

                                <!-- Action buttons -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" Content="View Schedule" Style="{StaticResource CardActionButtonStyle}"
                                            Margin="0" Background="{DynamicResource AccentSolidBrush}" Foreground="White"
                                            Command="{Binding DataContext.ViewScheduleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>

                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>  
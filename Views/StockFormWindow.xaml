<Window x:Class="Finvora.Views.StockFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Finvora.Converters"
        Title="Stock Item"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        AllowsTransparency="True"
        Background="Transparent"
        Width="680" SizeToContent="Height"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <conv:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <conv:PascalCaseToSpacedConverter x:Key="PascalCaseToSpacedConverter"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="FieldTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource BackgroundSecondaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentSolidBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FieldComboBox" TargetType="ComboBox" BasedOn="{StaticResource AppComboBoxBaseStyle}"/>

        <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource TextSubheading}">
            <Setter Property="Margin" Value="0,4,0,14"/>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource SurfaceCardBrush}" CornerRadius="12"
            BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="24,20,24,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding HeaderTitle}" Style="{StaticResource TextHeading}"/>
                    <TextBlock Text="{Binding HeaderSubtitle}" Style="{StaticResource TextCaption}" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                        Width="28" Height="28" Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand"
                        Command="{Binding CancelCommand}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Form body -->
            <ScrollViewer Grid.Row="1" MaxHeight="600" VerticalScrollBarVisibility="Auto" Margin="24,10,32,0" Padding="0,0,8,0">
                <StackPanel>

                    <TextBlock Text="Distributor / Importer Details" Style="{StaticResource SectionHeader}"/>

                    <TextBlock Text="Distributor / Importer Name *" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding DistributorName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBox}" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Phone" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding DistributorPhone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Email" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding DistributorEmail, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBox}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Address" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding DistributorAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Reference / Invoice #" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding ImporterReference, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBox}"/>
                        </StackPanel>
                    </Grid>

                    <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,20"/>

                    <TextBlock Text="Stock Item Details" Style="{StaticResource SectionHeader}"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Item Name *" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding ItemName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Reference # *" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding ReferenceNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBox}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Category" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}" IsEditable="True"
                                      ItemsSource="{Binding SuggestedCategories}" Style="{StaticResource FieldComboBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Condition *" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding ConditionOptions}" SelectedItem="{Binding Condition}" Style="{StaticResource FieldComboBox}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource PascalCaseToSpacedConverter}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Quantity *" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Minimum Stock Level" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding MinimumStockText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBox}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Dealer Price *" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding DealerPriceText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="End User Price *" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding EndUserPriceText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBox}"/>
                        </StackPanel>
                    </Grid>

                    <Border Background="{DynamicResource BackgroundSecondaryBrush}" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Stock Value (Quantity x Dealer Price)" Style="{StaticResource TextCaption}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding StockValuePreview, StringFormat='Rs {0:N0}'}"
                                       Style="{StaticResource TextBody}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentSolidBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="Notes / Description" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBox}"
                              AcceptsReturn="True" Height="60" TextWrapping="Wrap" Margin="0,0,0,4"/>

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorBrush}"
                               TextWrapping="Wrap" Margin="0,14,0,0"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Grid Grid.Row="2" Margin="24,20,24,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelCommand}"
                        Padding="18,9" Margin="0,0,10,0" Background="Transparent"
                        Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="1"
                        BorderBrush="{DynamicResource BorderDefaultBrush}" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Grid.Column="2" Content="Save" Command="{Binding SaveCommand}"
                        IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBooleanConverter}}"
                        Padding="18,9" FontWeight="SemiBold" Background="{DynamicResource AccentSolidBrush}"
                        Foreground="White" BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}" Opacity="{TemplateBinding Opacity}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.6"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window> 
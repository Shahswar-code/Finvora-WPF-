<UserControl x:Class="Finvora.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:views="clr-namespace:Finvora.Views">

    <ScrollViewer VerticalScrollBarVisibility="Hidden"> 
        <StackPanel>

            <!-- Header -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}">
                        <Run Text="{Binding Greeting, Mode=OneWay}"/><Run Text=", "/><Run Text="{Binding BusinessName}"/><Run Text="!"/>
                    </TextBlock>
                    <TextBlock Text="Here's your real-time business analytics."
                               Style="{StaticResource TextCaption}" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="Refresh" Command="{Binding RefreshCommand}"
                            Padding="18,9" Margin="0,0,10,0" FontWeight="SemiBold"
                            Background="{DynamicResource AccentSolidBrush}" Foreground="White"
                            BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <ComboBox ItemsSource="{Binding Periods}" SelectedItem="{Binding SelectedPeriod}"
                              Width="120" Padding="8,6"/>
                </StackPanel>
            </Grid>

            <!-- Stat cards row 1 -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- 💰 TOTAL REVENUE -->
                <views:StatCardView Grid.Column="0" Title="TOTAL REVENUE" Value="{Binding TotalRevenue}" Badge="&#xE8C7;" AccentBrush="{DynamicResource AccentSolidBrush}"/>
                <!-- ⏳ PENDING BALANCE -->
                <views:StatCardView Grid.Column="2" Title="PENDING BALANCE" Value="{Binding PendingBalance}" Badge="&#xE7BA;" AccentBrush="{DynamicResource WarningBrush}"/>
                <!-- ⚠ OVERDUE AMOUNT -->
                <views:StatCardView Grid.Column="4" Title="OVERDUE AMOUNT" Value="{Binding OverdueAmount}" Badge="&#xE7BA;" AccentBrush="{DynamicResource ErrorBrush}"/>
                <!-- ✅ COLLECTED THIS PERIOD -->
                <views:StatCardView Grid.Column="6" Title="COLLECTED THIS PERIOD" Value="{Binding CollectedThisPeriod}" Badge="&#xE73E;" AccentBrush="{DynamicResource SuccessBrush}"/>
            </Grid>

            <!-- Stat cards row 2 -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- 👥 TOTAL CUSTOMERS -->
                <views:StatCardView Grid.Column="0" Title="TOTAL CUSTOMERS" Value="{Binding TotalCustomers}" Badge="&#xE716;" AccentBrush="{DynamicResource PartialBrush}"/>
                <!-- 👤 ACTIVE CUSTOMERS -->
                <views:StatCardView Grid.Column="2" Title="ACTIVE CUSTOMERS" Value="{Binding ActiveCustomers}" Badge="&#xE77B;" AccentBrush="{DynamicResource SuccessBrush}"/>
                <!-- ✓ COMPLETED PLANS -->
                <views:StatCardView Grid.Column="4" Title="COMPLETED PLANS" Value="{Binding CompletedPlans}" Badge="&#xE73E;" AccentBrush="{DynamicResource TextMutedBrush}"/>
                <!-- 📋 TOTAL PLANS -->
                <views:StatCardView Grid.Column="6" Title="TOTAL PLANS" Value="{Binding TotalPlans}" Badge="&#xE8FD;" AccentBrush="{DynamicResource WarningBrush}"/>
            </Grid>

            <!-- Installment Summary + Cash Flow -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="1.6*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource SurfaceCardBrush}" CornerRadius="10" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Installment Summary" Style="{StaticResource TextSubheading}" Margin="0,0,0,16"/>
                        <Grid>
                            <lvc:PieChart Series="{Binding InstallmentSeries}" InitialRotation="-90"
                                               TooltipPosition="Hidden"
                                          Background="Transparent"
                                          Width="200" Height="200" HorizontalAlignment="Center"/>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock Text="{Binding TotalPlans}" Style="{StaticResource TextMetric}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Plans" Style="{StaticResource TextCaption}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Margin="0,18,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding PaidSummary}" Margin="10,0,0,0" Style="{StaticResource TextBody}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource WarningBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding PendingSummary}" Margin="10,0,0,0" Style="{StaticResource TextBody}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource ErrorBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding OverdueSummary}" Margin="10,0,0,0" Style="{StaticResource TextBody}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource PartialBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding PartialSummary}" Margin="10,0,0,0" Style="{StaticResource TextBody}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{DynamicResource SurfaceCardBrush}" CornerRadius="10" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Cash Flow Overview" Style="{StaticResource TextSubheading}" Margin="0,0,0,16"/>
                        <lvc:CartesianChart Series="{Binding CashFlowSeries}" XAxes="{Binding CashFlowXAxes}"
                                             YAxes="{Binding CashFlowYAxes}" Background="Transparent" Height="260"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Monthly Revenue vs Pending -->
            <Border Background="{DynamicResource SurfaceCardBrush}" CornerRadius="10" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Monthly Revenue vs Pending — Current Year" Style="{StaticResource TextSubheading}"/>
                    <lvc:CartesianChart Series="{Binding MonthlySeries}" XAxes="{Binding MonthlyXAxes}"
                                         YAxes="{Binding MonthlyYAxes}" Background="Transparent" Height="260" Margin="0,16,0,0"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>  
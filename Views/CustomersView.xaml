<UserControl x:Class="Finvora.Views.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Finvora.Views"
             xmlns:converters="clr-namespace:Finvora.Converters"
             xmlns:models="clr-namespace:Finvora.Models">

    <UserControl.Resources>
        <converters:StringEqualsConverter x:Key="StringEqualsConverter"/>
        <converters:PercentToWidthConverter x:Key="PercentToWidthConverter"/>
        <converters:PercentToWidthMultiConverter x:Key="PercentToWidthMultiConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Filter pill (All/Active/Overdue/Complete) -->
        <Style x:Key="FilterPillStyle" TargetType="RadioButton">
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSolidBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Header action buttons (Add New Customer / Export All PDF) -->
        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small action buttons on each card (View/Edit/Delete/PDF) -->
        <Style x:Key="CardActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="0,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,20">

            <!-- Header -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Customers" FontSize="24" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Manage all your installment customers"
                               Style="{StaticResource TextCaption}" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="Add New Customer" Command="{Binding AddNewCustomerCommand}"
                            Background="{DynamicResource AccentSolidBrush}"
                            Style="{StaticResource HeaderButtonStyle}" Margin="0,0,10,0"/>
                    <Button Content="Export All PDF" Command="{Binding ExportAllCommand}"
                            Background="{DynamicResource ExportAccentBrush}"
                            Style="{StaticResource HeaderButtonStyle}"/>
                </StackPanel>
            </Grid>

            <!-- Stat cards -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <views:StatCardView Grid.Column="0" Title="TOTAL CUSTOMERS" Value="{Binding TotalCustomers}"
                                     Badge="&#xE716;" AccentBrush="{DynamicResource AccentSolidBrush}"/>
                <views:StatCardView Grid.Column="2" Title="TOTAL PLANS" Value="{Binding TotalPlans}"
                                     Badge="&#xE8FD;" AccentBrush="{DynamicResource PartialBrush}"/>
                <views:StatCardView Grid.Column="4" Title="PENDING BALANCE" Value="{Binding PendingBalance}"
                                     Badge="&#xE7BA;" AccentBrush="{DynamicResource WarningBrush}"/>
                <views:StatCardView Grid.Column="6" Title="OVERDUE" Value="{Binding OverdueCount}"
                                     Badge="&#xE7BA;" AccentBrush="{DynamicResource ErrorBrush}"/>
            </Grid>

            <!-- Search + filters -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="12,9" Background="{DynamicResource SurfaceCardBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="1"
                             BorderBrush="{DynamicResource BorderDefaultBrush}"/>
                    <TextBlock Text="Search by name, CNIC or phone..." IsHitTestVisible="False"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="12,0,0,0"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton Content="All" GroupName="StatusFilter" Style="{StaticResource FilterPillStyle}"
                                 Command="{Binding SetFilterCommand}" CommandParameter="All"
                                 IsChecked="{Binding SelectedFilter, Converter={StaticResource StringEqualsConverter}, ConverterParameter=All, Mode=OneWay}"/>
                    <RadioButton Content="Active" GroupName="StatusFilter" Style="{StaticResource FilterPillStyle}"
                                 Command="{Binding SetFilterCommand}" CommandParameter="Active"
                                 IsChecked="{Binding SelectedFilter, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Active, Mode=OneWay}"/>
                    <RadioButton Content="Overdue" GroupName="StatusFilter" Style="{StaticResource FilterPillStyle}"
                                 Command="{Binding SetFilterCommand}" CommandParameter="Overdue"
                                 IsChecked="{Binding SelectedFilter, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Overdue, Mode=OneWay}"/>
                    <RadioButton Content="Complete" GroupName="StatusFilter" Style="{StaticResource FilterPillStyle}"
                                 Command="{Binding SetFilterCommand}" CommandParameter="Complete"
                                 IsChecked="{Binding SelectedFilter, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Complete, Mode=OneWay}"/>
                </StackPanel>
            </Grid>

            <!-- Empty state -->
            <StackPanel HorizontalAlignment="Center" Margin="0,60,0,0"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="32"
                           Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="No customers found" Style="{StaticResource TextSubheading}"
                           HorizontalAlignment="Center" Margin="0,10,0,4"/>
                <TextBlock Text="Add your first customer, or try a different search/filter."
                           Style="{StaticResource TextCaption}" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Customer cards -->
            <ItemsControl ItemsSource="{Binding FilteredCustomers}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="460" Background="{DynamicResource SurfaceCardBrush}"
                                CornerRadius="10" Padding="18" Margin="0,0,16,16">
                            <StackPanel>

                                <!-- Top row: avatar, name/phone/item, category badge -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22"
                                            Background="{DynamicResource AccentGradientBrush}"
                                            VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Initial}" Foreground="White"
                                                   FontWeight="Bold" FontSize="16"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="{Binding FullName}" Style="{StaticResource TextSubheading}"/>
                                        <TextBlock Text="{Binding Phone}" Style="{StaticResource TextCaption}" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding ItemName}" Style="{StaticResource TextCaption}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <Border Grid.Column="2" CornerRadius="5" Padding="9,4" VerticalAlignment="Top">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding FilterCategory}" Value="Overdue">
                                                        <Setter Property="Background" Value="{DynamicResource ErrorBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding FilterCategory}" Value="Complete">
                                                        <Setter Property="Background" Value="{DynamicResource TextMutedBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding FilterCategory}" FontSize="11"
                                                   FontWeight="SemiBold" Foreground="White"/>
                                    </Border>
                                </Grid>

                                <!-- Financial summary row -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Total" Style="{StaticResource TextCaption}"/>
                                        <TextBlock Text="{Binding TotalPrice, StringFormat='Rs {0:N0}'}"
                                                   Style="{StaticResource TextBody}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Advance" Style="{StaticResource TextCaption}"/>
                                        <TextBlock Text="{Binding AdvancePaid, StringFormat='Rs {0:N0}'}"
                                                   Style="{StaticResource TextBody}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SuccessBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Remaining" Style="{StaticResource TextCaption}"/>
                                        <TextBlock Text="{Binding RemainingBalance, StringFormat='Rs {0:N0}'}"
                                                   Style="{StaticResource TextBody}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource WarningBrush}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Payment progress -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Payment Progress" Style="{StaticResource TextCaption}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding PaymentProgressPercent, StringFormat='{}{0:0}%'}"
                                               Style="{StaticResource TextCaption}" Margin="0,0,8,0"/>
                                    <Border Grid.Column="2" CornerRadius="4" Padding="7,2">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource TextMutedBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:PaymentStatus.Paid}">
                                                        <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:PaymentStatus.Partial}">
                                                        <Setter Property="Background" Value="{DynamicResource PartialBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                                    </Border>
                                </Grid>

                                <Border x:Name="ProgressTrack" Height="6" Background="{DynamicResource SurfaceCardHoverBrush}"
        CornerRadius="3" ClipToBounds="True" Margin="0,0,0,10">
                                    <Border HorizontalAlignment="Left" CornerRadius="3"
            Background="{DynamicResource SuccessBrush}">
                                        <Border.Width>
                                            <MultiBinding Converter="{StaticResource PercentToWidthMultiConverter}">
                                                <MultiBinding.Bindings>
                                                    <Binding Path="PaymentProgressPercent"/>
                                                    <Binding ElementName="ProgressTrack" Path="ActualWidth"/>
                                                </MultiBinding.Bindings>
                                            </MultiBinding>
                                        </Border.Width>
                                    </Border>
                                </Border>

                                <!-- Paid + installment label / dates -->
                                <TextBlock Style="{StaticResource TextCaption}" Margin="0,0,0,2">
                                   <Run Text="{Binding AmountPaid, StringFormat='Rs {0:N0} paid', Mode=OneWay}"/>
                                    <Run Text="   "/>
                                    <Run Text="Rs "/><Run Text="{Binding InstallmentAmount, StringFormat={}{0:N0}, Mode=OneWay}"/><Run Text="/"/><Run Text="{Binding PlanShortLabel, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Style="{StaticResource TextCaption}" Margin="0,0,0,14">
                                   <Run Text="{Binding AmountPaid, StringFormat='Rs {0:N0} paid', Mode=OneWay}"/> 
                                    <Run Text="Added: "/><Run Text="{Binding DateAdded, StringFormat={}{0:dd MMM yyyy}, Mode=OneWay}"/>
                                     <Run Text="   Due: "/><Run Text="{Binding DueDate, StringFormat={}{0:dd MMM yyyy}, Mode=OneWay}"/>
                                </TextBlock>

                                <!-- Action buttons -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" Content="View" Style="{StaticResource CardActionButtonStyle}"
                                            Background="{DynamicResource AccentSolidBrush}" Foreground="White"
                                            Command="{Binding DataContext.ViewCustomerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Grid.Column="1" Content="Edit" Style="{StaticResource CardActionButtonStyle}"
                                            Background="{DynamicResource WarningBrush}" Foreground="Black"
                                            Command="{Binding DataContext.EditCustomerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Grid.Column="2" Content="Delete" Style="{StaticResource CardActionButtonStyle}"
                                            Background="{DynamicResource ErrorBrush}" Foreground="White"
                                            Command="{Binding DataContext.DeleteCustomerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Grid.Column="3" Content="PDF" Style="{StaticResource CardActionButtonStyle}"
                                            Margin="0" Background="{DynamicResource SuccessBrush}" Foreground="White"
                                            Command="{Binding DataContext.ExportCustomerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>

                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>  
<UserControl x:Class="Finvora.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Finvora.ViewModels"
             xmlns:conv="clr-namespace:Finvora.Converters">

    <UserControl.Resources>
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="FieldTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource BackgroundSecondaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentSolidBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryActionButton" TargetType="Button">
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{DynamicResource AccentSolidBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineActionButton" TargetType="Button">
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Hidden">
        <StackPanel Margin="0,0,0,20">

            <!-- Header -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Settings" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="Manage your business profile and data." Style="{StaticResource TextCaption}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Business Profile card -->
            <Border Background="{DynamicResource SurfaceCardBrush}" CornerRadius="10" Padding="24" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Business Profile" Style="{StaticResource TextSubheading}" Margin="0,0,0,4"/>
                    <TextBlock Text="This name appears on your Dashboard and on exported invoices."
                               Style="{StaticResource TextCaption}" Margin="0,0,0,18"/>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Business Name" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding BusinessName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Owner Name" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding OwnerName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBox}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Contact Phone" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding ContactPhone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Currency Symbol" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding CurrencySymbol, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBox}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,0,0,18">
                        <TextBlock Text="Business Address" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding ContactAddress, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FieldTextBox}" TextWrapping="Wrap" AcceptsReturn="True" Height="60"/>
                    </StackPanel>

                    <Button Content="Save Profile" Command="{Binding SaveProfileCommand}" Style="{StaticResource PrimaryActionButton}"/>
                </StackPanel>
            </Border>

            <!-- Backup & Restore card -->
            <Border Background="{DynamicResource SurfaceCardBrush}" CornerRadius="10" Padding="24" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Data Backup &amp; Restore" Style="{StaticResource TextSubheading}" Margin="0,0,0,4"/>
                    <TextBlock Text="Backups are saved automatically to your Finvora Backups folder."
                               Style="{StaticResource TextCaption}" Margin="0,0,0,18"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Backup -->
                        <Border Grid.Column="0" Background="{DynamicResource BackgroundSecondaryBrush}" CornerRadius="8" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="Create Backup" Style="{StaticResource TextBody}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock Text="Saves a full snapshot of your database as a single file." Style="{StaticResource TextCaption}"
                                           TextWrapping="Wrap" Margin="0,0,0,14"/>
                                <Button Content="Backup Now" Command="{Binding BackupDataCommand}"
                                        Style="{StaticResource OutlineActionButton}"
                                        Foreground="{DynamicResource SuccessBrush}" BorderBrush="{DynamicResource SuccessBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Restore -->
                        <Border Grid.Column="2" Background="{DynamicResource BackgroundSecondaryBrush}" CornerRadius="8" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="Restore from Backup" Style="{StaticResource TextBody}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock Text="Replaces all current data with a previously saved backup file." Style="{StaticResource TextCaption}"
                                           TextWrapping="Wrap" Margin="0,0,0,14"/>
                                <Button Content="Restore..." Command="{Binding RestoreDataCommand}"
                                        Style="{StaticResource OutlineActionButton}"
                                        Foreground="{DynamicResource WarningBrush}" BorderBrush="{DynamicResource WarningBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
            <!-- Security & Reset card -->
            <Border Background="{DynamicResource SurfaceCardBrush}" CornerRadius="10" Padding="24" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Security &amp; Danger Zone" Style="{StaticResource TextSubheading}" Margin="0,0,0,4"/>
                    <TextBlock Text="Resetting all data requires your PIN and cannot be undone."
                               Style="{StaticResource TextCaption}" Margin="0,0,0,18"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Change PIN -->
                        <Border Grid.Column="0" Background="{DynamicResource BackgroundSecondaryBrush}" CornerRadius="8" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="Security PIN" Style="{StaticResource TextBody}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock Text="Set or change the PIN required to reset all data." Style="{StaticResource TextCaption}"
                                           TextWrapping="Wrap" Margin="0,0,0,14"/>
                                <Button Content="Change PIN" Command="{Binding ChangePinCommand}"
                                        Style="{StaticResource OutlineActionButton}"
                                        Foreground="{DynamicResource AccentSolidBrush}" BorderBrush="{DynamicResource AccentSolidBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Reset All Data -->
                        <Border Grid.Column="2" Background="{DynamicResource BackgroundSecondaryBrush}" CornerRadius="8" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="Reset All Data" Style="{StaticResource TextBody}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock Text="Permanently deletes all customers, plans, and payment records." Style="{StaticResource TextCaption}"
                                           TextWrapping="Wrap" Margin="0,0,0,14"/>
                                <Button Content="Reset All Data" Command="{Binding ResetAllDataCommand}"
                                        Style="{StaticResource OutlineActionButton}"
                                        Foreground="{DynamicResource ErrorBrush}" BorderBrush="{DynamicResource ErrorBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border> 

            <!-- Status message -->
            <TextBlock Text="{Binding SaveMessage}" Style="{StaticResource TextCaption}"
                       Foreground="{DynamicResource AccentSolidBrush}"
                       Visibility="{Binding SaveMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

        </StackPanel>
    </ScrollViewer>
</UserControl> 
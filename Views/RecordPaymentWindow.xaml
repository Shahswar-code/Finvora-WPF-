<Window x:Class="Finvora.Views.RecordPaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Finvora.Converters"
        xmlns:models="clr-namespace:Finvora.Models"
        Title="Record Payment"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        AllowsTransparency="True"
        Background="Transparent"
        Width="620" SizeToContent="Height"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <conv:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <conv:PascalCaseToSpacedConverter x:Key="PascalCaseToSpacedConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="FieldTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource BackgroundSecondaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentSolidBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FieldComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource BackgroundSecondaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <Style x:Key="FieldDatePicker" TargetType="DatePicker">
            <Setter Property="Background" Value="{DynamicResource BackgroundSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>

        <!-- One selectable outstanding-installment row. A plain ListBoxItem
             template so the whole row is clickable and shows a clear
             selected state, rather than a tiny radio dot. -->
        <Style x:Key="ScheduleRowItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="RowBorder" CornerRadius="8" Padding="14,10"
                                Background="{DynamicResource BackgroundSecondaryBrush}"
                                BorderThickness="1.5" BorderBrush="Transparent" Cursor="Hand">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource AccentSolidBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource SurfaceCardBrush}" CornerRadius="12"
            BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="24,20,24,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Record Payment" Style="{StaticResource TextHeading}"/>
                    <TextBlock Text="Apply a payment to a specific installment due date" Style="{StaticResource TextCaption}" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                        Width="28" Height="28" Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand"
                        Command="{Binding CancelCommand}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Form body -->
            <ScrollViewer Grid.Row="1" MaxHeight="580" VerticalScrollBarVisibility="Auto" Margin="24,10,32,0" Padding="0,0,8,0">
                <StackPanel>

                    <TextBlock Text="Customer" Style="{StaticResource TextSubheading}" Margin="0,4,0,12"/>
                    <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}"
                              DisplayMemberPath="FullName" IsEditable="True" IsTextSearchEnabled="True"
                              Style="{StaticResource FieldComboBox}" Margin="0,0,0,16"/>

                    <!-- Installment plan picker (only shows once a customer with outstanding plans is chosen) -->
                    <StackPanel Visibility="{Binding SelectedCustomer, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                        <TextBlock Text="Installment Plan" Style="{StaticResource TextSubheading}" Margin="0,0,0,12"/>

                        <TextBlock Text="This customer has no outstanding installment plans." Style="{StaticResource TextCaption}"
                                   Margin="0,0,0,16"
                                  Visibility="{Binding CustomerInstallments.Count, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Inverse}"/>

                        <ComboBox ItemsSource="{Binding CustomerInstallments}" SelectedItem="{Binding SelectedInstallment}"
                                  DisplayMemberPath="InstallmentNumber" Style="{StaticResource FieldComboBox}" Margin="0,0,0,16"
                                 Visibility="{Binding HasInstallments, Converter={StaticResource BoolToVis}}"/> 

                        <!-- Outstanding due dates for the selected plan -->
                        <StackPanel Visibility="{Binding SelectedInstallment, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                            <TextBlock Text="Select the due date being paid" Style="{StaticResource FieldLabel}"/>
                            <ListBox ItemsSource="{Binding OutstandingRows}" SelectedItem="{Binding SelectedScheduleRow}"
                                     BorderThickness="0" Background="Transparent" Margin="0,0,0,4"
                                     ItemContainerStyle="{StaticResource ScheduleRowItemStyle}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding SequenceNumber, StringFormat='#{0:00}'}"
                                                       Style="{StaticResource TextCaption}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DueDate, StringFormat='Due {0:dd MMM yyyy}'}" Style="{StaticResource TextBody}"/>
                                                <TextBlock Style="{StaticResource TextCaption}">
                                                    <Run Text="Rs "/><Run Text="{Binding PaidAmount, StringFormat={}{0:N0}, Mode=OneWay}"/>
                                                    <Run Text=" of Rs "/><Run Text="{Binding Amount, StringFormat={}{0:N0}, Mode=OneWay}"/>
                                                    <Run Text=" paid"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" Text="{Binding RemainingAmount, StringFormat='Rs {0:N0}'}"
                                                       Style="{StaticResource TextBody}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                            <Border Grid.Column="3" CornerRadius="5" Padding="8,3" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource TextMutedBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ScheduleStatus.Overdue}">
                                                                <Setter Property="Background" Value="{DynamicResource ErrorBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ScheduleStatus.DueToday}">
                                                                <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ScheduleStatus.Partial}">
                                                                <Setter Property="Background" Value="{DynamicResource PartialBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </StackPanel>

                    <!-- Payment details only shown once a due date is picked -->

                    <StackPanel Visibility="{Binding HasSelectedRow, Converter={StaticResource BoolToVis}}">
                        <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0,1,0,0" Margin="0,4,0,16"/>
                        <TextBlock Text="Payment Details" Style="{StaticResource TextSubheading}" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Payment Amount *" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Payment Method" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding MethodOptions}" SelectedItem="{Binding Method}" Style="{StaticResource FieldComboBox}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource PascalCaseToSpacedConverter}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Reference #" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding ReferenceNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Payment Date" Style="{StaticResource FieldLabel}"/>
                                <DatePicker SelectedDate="{Binding PaymentDate}" Style="{StaticResource FieldDatePicker}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Notes" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBox}"
                                  AcceptsReturn="True" Height="60" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    </StackPanel>

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorBrush}"
                               TextWrapping="Wrap" Margin="0,14,0,0"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Grid Grid.Row="2" Margin="24,20,24,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelCommand}"
                        Padding="18,9" Margin="0,0,10,0" Background="Transparent"
                        Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="1"
                        BorderBrush="{DynamicResource BorderDefaultBrush}" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Grid.Column="2" Content="Record Payment" Command="{Binding SaveCommand}"
                        IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBooleanConverter}}"
                        Padding="18,9" FontWeight="SemiBold" Background="{DynamicResource AccentSolidBrush}"
                        Foreground="White" BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}" Opacity="{TemplateBinding Opacity}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.6"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window> 